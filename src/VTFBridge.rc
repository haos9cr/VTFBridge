    COMBOBOX        IDC_PV_MODE, 52, 25, 154, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PV_LBL_REF, 212, 27, 40, 9
