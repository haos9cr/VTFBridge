// VTFBridge.rc - dialog and PiPL resources (UTF-8).
// Captions are placeholders: the real texts are set at runtime from Lang.cpp
// and the language files (see ApplyTexts() in VTFBridgeUI.cpp).
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "Version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_VTF_OPTIONS DIALOGEX 0, 0, 410, 358
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VTF"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_INFO, 7, 7, 220, 9
    RTEXT           "Language:", IDC_LBL_LANG, 230, 7, 70, 9
    COMBOBOX        IDC_LANG, 303, 5, 100, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Format", IDC_GRP_FORMAT, 7, 20, 250, 62
    LTEXT           "", IDC_LBL_FORMAT, 14, 33, 44, 9
    COMBOBOX        IDC_FORMAT, 60, 31, 190, 240, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_VERSION, 14, 49, 44, 9
    COMBOBOX        IDC_VERSION, 60, 47, 50, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT           "", IDC_LBL_DXTQ, 112, 49, 40, 9
    COMBOBOX        IDC_DXTQ, 154, 47, 96, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_ALPHA, 14, 65, 44, 9
    COMBOBOX        IDC_ALPHA, 60, 63, 190, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Resize", IDC_GRP_RESIZE, 7, 86, 250, 94
    AUTOCHECKBOX    "", IDC_RESIZE, 14, 98, 236, 10
    LTEXT           "", IDC_LBL_METHOD, 24, 113, 82, 9
    COMBOBOX        IDC_METHOD, 108, 111, 142, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_RFILTER, 24, 129, 82, 9
    COMBOBOX        IDC_RFILTER, 108, 127, 142, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_MAXW, 24, 145, 82, 9
    COMBOBOX        IDC_MAXW, 108, 143, 80, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_MAXH, 24, 161, 82, 9
    COMBOBOX        IDC_MAXH, 108, 159, 80, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Mipmaps", IDC_GRP_MIPS, 7, 184, 250, 94
    AUTOCHECKBOX    "", IDC_MIPMAPS, 14, 196, 236, 10
    LTEXT           "", IDC_LBL_MIPFILTER, 24, 211, 82, 9
    COMBOBOX        IDC_MIPFILTER, 108, 209, 142, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_SHARPEN, 24, 227, 82, 9
    CONTROL         "", IDC_SHARPEN, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 104, 225, 66, 14
    LTEXT           "", IDC_SHARPEN_VAL, 171, 227, 20, 9
    AUTOCHECKBOX    "", IDC_SHARPEN_ALPHA, 192, 226, 64, 10
    AUTOCHECKBOX    "", IDC_GAMMA, 14, 240, 236, 10
    AUTOCHECKBOX    "", IDC_TILING, 14, 252, 236, 10
    AUTOCHECKBOX    "", IDC_THUMB, 14, 264, 236, 10

    GROUPBOX        "Animation", IDC_GRP_ANIM, 7, 282, 250, 52
    AUTOCHECKBOX    "", IDC_ANIMATE, 14, 294, 236, 10
    LTEXT           "", IDC_LBL_ORDER, 24, 309, 82, 9
    COMBOBOX        IDC_ORDER, 108, 307, 142, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ANIM_HINT, 24, 322, 226, 9

    GROUPBOX        "Flags", IDC_GRP_FLAGS, 263, 20, 140, 256
    AUTOCHECKBOX    "", 1100, 270, 33, 128, 10
    AUTOCHECKBOX    "", 1101, 270, 48, 128, 10
    AUTOCHECKBOX    "", 1102, 270, 63, 128, 10
    AUTOCHECKBOX    "", 1103, 270, 78, 128, 10
    AUTOCHECKBOX    "", 1104, 270, 93, 128, 10
    AUTOCHECKBOX    "", 1105, 270, 108, 128, 10
    AUTOCHECKBOX    "", 1106, 270, 123, 128, 10
    AUTOCHECKBOX    "", 1107, 270, 138, 128, 10
    AUTOCHECKBOX    "", 1108, 270, 153, 128, 10
    AUTOCHECKBOX    "", 1109, 270, 168, 128, 10
    AUTOCHECKBOX    "", 1110, 270, 183, 128, 10
    AUTOCHECKBOX    "", 1111, 270, 198, 128, 10
    AUTOCHECKBOX    "", 1112, 270, 213, 128, 10
    AUTOCHECKBOX    "", 1113, 270, 228, 128, 10
    AUTOCHECKBOX    "", 1114, 270, 243, 128, 10
    AUTOCHECKBOX    "", 1115, 270, 258, 128, 10

    GROUPBOX        "Material", IDC_GRP_VMT, 263, 280, 140, 54
    AUTOCHECKBOX    "", IDC_VMT, 270, 294, 128, 10
    COMBOBOX        IDC_SHADER, 270, 309, 128, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Reset", IDC_RESET, 7, 338, 60, 14
    PUSHBUTTON      "Preview", IDC_PREVIEW, 72, 338, 72, 14
    LTEXT           "", IDC_FILESIZE, 150, 341, 126, 9
    DEFPUSHBUTTON   "Save", IDOK, 279, 338, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 343, 338, 60, 14
END

IDD_VTF_SETTINGS DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LBL_LANG, 7, 9, 90, 9
    COMBOBOX        IDC_LANG, 100, 7, 193, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "", IDC_GRP_ST_OPEN, 7, 24, 286, 50
    LTEXT           "", IDC_LBL_ST_ANIMALPHA, 14, 39, 84, 9
    COMBOBOX        IDC_ST_ANIMALPHA, 100, 37, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_ORDER, 14, 56, 84, 9
    COMBOBOX        IDC_ORDER, 100, 54, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "", IDC_GRP_ST_SAVE, 7, 80, 286, 154
    LTEXT           "", IDC_ST_SAVE_HINT, 14, 92, 272, 18
    LTEXT           "", IDC_LBL_DXTQ, 14, 115, 84, 9
    COMBOBOX        IDC_DXTQ, 100, 113, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_ALPHA, 14, 132, 84, 9
    COMBOBOX        IDC_ALPHA, 100, 130, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_MIPFILTER, 14, 149, 84, 9
    COMBOBOX        IDC_MIPFILTER, 100, 147, 186, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LBL_SHARPEN, 14, 166, 84, 9
    CONTROL         "", IDC_SHARPEN, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 100, 164, 100, 14
    LTEXT           "", IDC_SHARPEN_VAL, 202, 166, 22, 9
    AUTOCHECKBOX    "", IDC_SHARPEN_ALPHA, 226, 165, 62, 10
    AUTOCHECKBOX    "", IDC_TILING, 14, 183, 272, 10
    AUTOCHECKBOX    "", IDC_VMT, 14, 199, 272, 10
    LTEXT           "", IDC_LBL_ST_SHADER, 24, 215, 74, 9
    COMBOBOX        IDC_SHADER, 100, 213, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Reset", IDC_RESET, 7, 242, 72, 14
    DEFPUSHBUTTON   "OK", IDOK, 169, 242, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 233, 242, 60, 14
END

IDD_VTF_ASK DIALOGEX 0, 0, 320, 164
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VTFBridge"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_ASK_TEXT, 10, 9, 300, 10
    PUSHBUTTON      "", IDC_ASK_LAYERS, 10, 25, 300, 36, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "", IDC_ASK_TRANSPARENCY, 10, 66, 300, 36, BS_OWNERDRAW | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ASK_REMEMBER, 10, 110, 300, 10
    LTEXT           "", IDC_ASK_HINT, 22, 122, 288, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 250, 143, 60, 14
END

IDD_VTF_PREVIEW DIALOGEX 0, 0, 600, 404
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Preview"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PV_LBL_LEVEL, 7, 9, 44, 9
    COMBOBOX        IDC_PV_LEVEL, 52, 7, 110, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
