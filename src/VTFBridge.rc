    COMBOBOX        IDC_PV_RFILTER, 505, 25, 88, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PV_LBL_FILTER, 7, 45, 64, 9
    COMBOBOX        IDC_PV_FILTER, 72, 43, 90, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PV_LBL_SHARP, 168, 45, 42, 9
    CONTROL         "", IDC_PV_SHARP, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 210, 43, 92, 14
    LTEXT           "", IDC_PV_SHARPVAL, 303, 45, 22, 9
    AUTOCHECKBOX    "", IDC_PV_SHARP_ALPHA, 326, 44, 54, 10
    LTEXT           "", IDC_PV_LBL_QUALITY, 382, 45, 60, 9
    COMBOBOX        IDC_PV_QUALITY, 444, 43, 149, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PV_LBL_FRAME, 7, 63, 44, 9
    COMBOBOX        IDC_PV_FRAME, 52, 61, 110, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "<", IDC_PV_PREVFRAME, 166, 61, 18, 13
    PUSHBUTTON      ">", IDC_PV_NEXTFRAME, 186, 61, 18, 13
    CONTROL         "", IDC_PV_AREA, "Static", SS_OWNERDRAW, 7, 80, 586, 292
    LTEXT           "", IDC_PV_INFO, 7, 377, 450, 9
    LTEXT           "", IDC_PV_HINT, 7, 389, 450, 9
    DEFPUSHBUTTON   "OK", IDOK, 469, 382, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 533, 382, 60, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VTFBRIDGE_VERSION_MAJOR, VTFBRIDGE_VERSION_MINOR, VTFBRIDGE_VERSION_PATCH, 0
PRODUCTVERSION  VTFBRIDGE_VERSION_MAJOR, VTFBRIDGE_VERSION_MINOR, VTFBRIDGE_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VTFBridge - Valve Texture Format plug-in for Adobe Photoshop"
            VALUE "FileVersion", VTFBRIDGE_VERSION_STR
            VALUE "InternalName", "VTFBridge"
            VALUE "OriginalFilename", "VTFBridge.8bi"
            VALUE "ProductName", "VTFBridge"
            VALUE "ProductVersion", VTFBRIDGE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// PiPL resource produced by Cnvtpipl from VTFBridge.r (see the .vcxproj custom build step).
#include "VTFBridge.pipl"

// JSON PiPL (Photoshop 2021+): the format plus the File > Automate commands of
// VTFBridgeTools.cpp. Older Photoshop versions use the binary PiPL above.
JSON_PIPL JSON "VTFBridge.json"
