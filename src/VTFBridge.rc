    LTEXT           "", IDC_PV_LBL_VIEW, 212, 9, 40, 9
    COMBOBOX        IDC_PV_VIEW, 254, 7, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
